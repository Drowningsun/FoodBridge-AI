# ============================================
# FoodBridge AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://foodbridge:foodbridge123@localhost:5432/foodbridge_db
POSTGRES_USER=foodbridge
POSTGRES_PASSWORD=foodbridge123
POSTGRES_DB=foodbridge_db

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your-super-secret-jwt-key-change-in-production
REFRESH_SECRET_KEY=your-refresh-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ML_API_URL=http://localhost:8001
NEXT_PUBLIC_APP_NAME=FoodBridge AI
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ML Services
ML_API_HOST=0.0.0.0
ML_API_PORT=8001
MODEL_PATH=./models

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379
